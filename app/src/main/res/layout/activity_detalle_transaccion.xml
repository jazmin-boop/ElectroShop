<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0288D1">

    <!-- Header con paleta de colores de Main (Celeste) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackDetalle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#0288D1"
            android:contentDescription="Volver" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de Venta"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprobante, ítem y desglose"
                android:textColor="#E1F5FE"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta Principal Blanca Redondeada -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        android:layout_marginTop="8dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Card de Producto / Monto -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/ivDetalleProducto"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/television"
                            android:layout_marginBottom="12dp"
                            android:contentDescription="Producto" />

                        <TextView
                            android:id="@+id/tvDetalleNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Producto Seleccionado"
                            android:textColor="#222222"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">
                            <TextView
                                android:id="@+id/tvBadgeComprobante"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Comprobante #1 "
                                android:textColor="#0288D1"
                                android:background="#E1F5FE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />
                            <TextView
                                android:id="@+id/tvBadgeItem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Ítem #1 "
                                android:textColor="#555555"
                                android:background="#EEEEEE"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetalleTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00"
                            android:textColor="#0288D1"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Importe Total Facturado"
                            android:textColor="#888888"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Desglose del Ítem -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desglose del Ítem"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#F8F9FA"
                                android:padding="12dp"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cantidad" android:textColor="#777" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvDetalleCantidad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 unid." android:textColor="#222" android:textSize="15sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E8F5E9"
                                android:padding="12dp"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Precio Unitario" android:textColor="#2E7D32" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvDetallePrecioUnitario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S/ 0.00" android:textColor="#2E7D32" android:textSize="15sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estado y Auditoría"
                            android:textColor="#777"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F8F9FA"
                            android:padding="12dp"
                            android:text="Transacción procesada correctamente. Stock descontado del almacén central."
                            android:textColor="#444"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Volver -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolverDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="VOLVER"
                    android:backgroundTint="#0288D1"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
